# Copy this file to .env.local for local edits.
# Stay in noindex/unofficial preview mode until the center approves publication.
VITE_PUBLICATION_APPROVED=false
# Set true ONLY when your uploaded real facility photographs have website-use permission.
# One or more approved .webp files in public/photos/ will then become visible.
VITE_PHOTOS_APPROVED=false
# Replace with the real approved site HTTPS domain before production publication.
VITE_SITE_URL=https://example.org
